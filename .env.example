# Copy to .env.local. All values are optional in M0: the defaults match `pnpm db:start`.

# Direct Postgres connection used by the background worker (pnpm jobs:work).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# How often the worker polls for due jobs.
JOBS_POLL_SECONDS=15

# The demo on Netlify: key for the plan-drafting function (netlify/functions/coach.mjs). Set it in Netlify, never here.
# ANTHROPIC_API_KEY=
# PATH_LLM_MODEL=claude-haiku-5-5
