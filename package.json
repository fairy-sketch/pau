{
  "name": "path-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "test:e2e": "playwright test",
    "test:proto": "PW_SKIP_SERVER=1 playwright test --project=prototype",
    "test:all": "pnpm test && pnpm test:e2e",
    "icons": "node scripts/generate-icons.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/server/database.types.ts",
    "jobs:work": "tsx scripts/worker.ts",
    "jobs:once": "tsx scripts/worker.ts --once"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@serwist/turbopack": "^9.5.14",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
